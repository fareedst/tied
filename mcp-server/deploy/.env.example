# Loaded from mcp-server/deploy/ when you run docker compose in this directory.
# From repo root you can instead use: docker compose --env-file .env -f mcp-server/deploy/docker-compose.https.example.yml ...

# Absolute path to the client repo (must contain tied-project/ and tied-bundle/). Default in compose: ../.. (store monorepo).
TIED_CLIENT_ROOT=/path/to/your/client-or-store-repo

TIED_MCP_HTTP_BEARER_TOKEN=change-me
