{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tied.local/contracts/harness-eval-replay-manifest-v1.json",
  "title": "HarnessEvalReplayManifestV1",
  "type": "object",
  "required": ["schema_version", "manifest_revision", "entries"],
  "properties": {
    "schema_version": { "const": "harness-eval-replay-manifest-v1" },
    "manifest_revision": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["client_root"],
        "properties": {
          "client_root": { "type": "string", "minLength": 1 },
          "trial_id": { "type": "string" },
          "jsonl_paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": true
}
