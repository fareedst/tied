{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tied.local/contracts/harness-eval-suite-v1.json",
  "title": "HarnessEvalSuiteV1",
  "type": "object",
  "required": ["schema_version", "suite_id", "suite_revision", "scenarios"],
  "properties": {
    "schema_version": { "const": "harness-eval-suite-v1" },
    "suite_id": { "type": "string", "minLength": 1 },
    "suite_revision": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "content_integrity_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenarios": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
