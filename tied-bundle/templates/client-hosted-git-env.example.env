# client-hosted-git-env.example.env — placeholders only (no secrets).
# Copy to client-owned .env.example or CI variable docs. Revoke any real token if ever pasted here.

# --- Generic (provider-neutral) ---
# TIED_GIT_CLOUD_PROVIDER=bitbucket
# TIED_REPO_OWNER=my-org
# TIED_REPO_NAME=my-repo
# Optional: single-segment "owner/repo" if your scripts expect it:
# TIED_REPO_FULL_NAME=my-org/my-repo
# TIED_DEV_BRANCH=develop
# TIED_PROD_BRANCH=production
# TIED_GIT_REMOTE_NAME=origin

# --- Credentials (use secret store or CI secrets; never commit) ---
# GIT_CLOUD_API_TOKEN=
# GIT_CLOUD_API_USER=
# Examples of vendor-specific names (pick one stack; delete the rest from your real file):
# ATLASSIAN_API_TOKEN=
# ATLASSIAN_EMAIL=
# GITHUB_TOKEN=
# GITLAB_TOKEN=

# --- Bitbucket Cloud (example mapping) ---
# BITBUCKET_WORKSPACE=my-workspace
# BITBUCKET_REPO_SLUG=my-repo

# --- GitHub (example mapping) ---
# GITHUB_OWNER=my-org
# GITHUB_REPO=my-repo

# --- GitLab (example mapping) ---
# GITLAB_PROJECT_PATH=my-group/my-project
# or GITLAB_PROJECT_ID=12345
