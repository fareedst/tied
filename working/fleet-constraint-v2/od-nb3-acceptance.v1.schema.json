{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "od-nb3-acceptance.v1",
  "title": "NB-3 sponsor acceptance — Track B tranche two authorization",
  "description": "Authorizes NB-3 (third Track B batch) after NB-2 tranche one complete; does not reopen closed orchestrator REQ close_out.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "status",
    "prior_batch_complete",
    "tranche_scope",
    "wave_3_client_ids",
    "orchestrator_reverify",
    "citdp_module_pointer",
    "plan_doc_pointer",
    "methodology_pin"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "od-nb3-acceptance.v1"
    },
    "acceptance_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id e.g. od-nb3-tranche-two-20260913"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "accepted", "withdrawn"]
    },
    "decided_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Required when status is accepted (ISO 8601; ajv format validator)"
    },
    "sponsor_signoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "required": ["name", "rationale"]
    },
    "prior_batch_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "close_out_receipt_path", "batch_req_token"],
      "properties": {
        "batch_id": { "type": "string", "const": "NB-2" },
        "batch_req_token": {
          "type": "string",
          "const": "REQ-PSEUDOCODE_FLEET_NB2_TRANCHE_ONE"
        },
        "close_out_receipt_path": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. working/fleet-constraint-v2/NB-2/gates/machine-close-out-2026-09-13.json"
        }
      }
    },
    "tranche_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "max_clients", "gate_stage", "enrollment_filter"],
      "properties": {
        "batch_id": { "type": "string", "const": "NB-3" },
        "max_clients": { "type": "integer", "minimum": 1, "maximum": 5 },
        "gate_stage": { "type": "string", "const": "G3" },
        "enrollment_filter": { "type": "string", "const": "not_enrolled_phase_4" }
      }
    },
    "wave_3_client_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "orchestrator_reverify": {
      "type": "boolean",
      "const": false,
      "description": "Must be false — REQ-PSEUDOCODE_CONSTRAINT_V2_FLEET_MIGRATION stays closed"
    },
    "citdp_module_pointer": {
      "type": "string",
      "minLength": 1,
      "description": "Path to CITDP file; module key nb3_tranche_two_module"
    },
    "plan_doc_pointer": {
      "type": "string",
      "minLength": 1
    },
    "methodology_pin": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. 48d1fbb+"
    },
    "evidence_pointers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": {
        "required": ["decided_at", "sponsor_signoff"],
        "properties": { "decided_at": { "type": "string" } }
      }
    }
  ]
}
