{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave-stop-go.v1",
  "title": "TIED fleet constraint v2 wave stop/go log",
  "description": "Append-only wave completion or halt decisions for Phase 4 G3 (OD-P4-6: single JSON array file).",
  "type": "array",
  "items": { "$ref": "#/$defs/stopGoRecord" },
  "$defs": {
    "stopGoDisposition": {
      "type": "string",
      "enum": ["go", "stop", "halt"]
    },
    "stopGoRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_id",
        "wave_id",
        "client_ids",
        "gate_stage",
        "disposition",
        "decided_at",
        "methodology_pin"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique id for this append entry (UUID recommended)."
        },
        "wave_id": { "type": "string", "minLength": 1 },
        "client_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate_stage": { "type": "string", "enum": ["G2", "G3"] },
        "disposition": { "$ref": "#/$defs/stopGoDisposition" },
        "decided_at": { "type": "string", "format": "date-time" },
        "methodology_pin": { "type": "string", "minLength": 1 },
        "blocking_evidence_gaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-empty when disposition is stop or halt."
        },
        "f11_fp_thresholds_ref": {
          "type": "string",
          "description": "Path to f11-fp-thresholds.v1.yaml when regression checked."
        },
        "receipt_summary_path": {
          "type": "string",
          "description": "Optional path to wave receipt batch summary JSON."
        },
        "operator": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
