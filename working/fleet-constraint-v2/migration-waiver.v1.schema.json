{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-waiver.v1",
  "title": "TIED fleet constraint v2 migration waiver",
  "description": "Time-bounded exception for procedures or clients not yet constraint-enforceable (OD-5: 90-day default).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "waiver_id",
    "owner",
    "reason",
    "issued_at",
    "expires_at",
    "scope",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "$schema": {
      "type": "string"
    },
    "waiver_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique waiver identifier referenced from inventory active_waiver_ids."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Accountable party (client owner per OD-5)."
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Default max duration 90 days from issue unless sponsor extends policy."
    },
    "remediation_req": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9_]+$",
      "description": "Owning REQ or follow-on work item that closes the waiver gap."
    },
    "scope": { "$ref": "#/$defs/waiverScope" },
    "status": {
      "type": "string",
      "enum": ["active", "expired", "superseded", "revoked"]
    },
    "renewal_of": {
      "type": "string",
      "description": "Prior waiver_id when this record renews an expired waiver."
    },
    "stdd_audit_note": {
      "type": "string",
      "description": "Optional stdd audit comment on renewal (OD-5)."
    }
  },
  "$defs": {
    "waiverScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["client", "sidecar_list", "procedure_ids"]
        },
        "client_id": {
          "type": "string",
          "description": "Required when kind is client."
        },
        "repository_root": { "type": "string" },
        "sidecar_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Relative paths under tied/implementation-decisions/ when kind is sidecar_list."
        },
        "procedure_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "UPPER_SNAKE procedure names when kind is procedure_ids."
        },
        "outcome_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unknown",
              "truncation",
              "unsupported_syntax",
              "constraint_gate_errors",
              "annotation_profile_gap"
            ]
          },
          "description": "Which analysis outcomes this waiver covers."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "client" } } },
          "then": { "required": ["client_id"] }
        },
        {
          "if": { "properties": { "kind": { "const": "sidecar_list" } } },
          "then": { "required": ["sidecar_paths"] }
        },
        {
          "if": { "properties": { "kind": { "const": "procedure_ids" } } },
          "then": { "required": ["procedure_ids"] }
        }
      ]
    }
  }
}
