# [IMPL-PRINT_FIRST_FIVE_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# Summary: Obtain five primes from an injectable prime generator, then write one decimal line per prime to an injectable output stream.

## PRINT_FIRST_FIVE_PRIMES
# [IMPL-PRINT_FIRST_FIVE_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# How: obtain five primes from injectable prime generator, then write lines.

Contract:
  INPUT: output stream; prime generator
  OUTPUT: five lines on output stream
  DATA: primes_list
  CONTROL: default prime generator is FIRST_N_PRIMES; default output stream is process stdout
  PRE: generator honors FIRST_N_PRIMES for count 5
  POST: stream received five lines matching generator output
  EFFECTS: IO
  FAILURE_MODES: WriteFailure
  TERMINATION: total

procedure PRINT_FIRST_FIVE_PRIMES:
  SET primes_list = CALL prime generator with count 5
  CALL WRITE_PRIME_LINES(primes_list, output stream)

## WRITE_PRIME_LINES
# [IMPL-PRINT_FIRST_FIVE_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# How: for each prime in order, write decimal digits plus newline.

Contract:
  INPUT: primes_list; output stream
  OUTPUT: lines on output stream
  PRE: primes_list is an ordered list of integers
  POST: each prime written as decimal digits followed by newline, in list order
  EFFECTS: IO
  FAILURE_MODES: WriteFailure
  DATA_TRANSITION: stream cursor advances one line per prime
  TERMINATION: total

procedure WRITE_PRIME_LINES:
  FOR each prime IN primes_list:
    TRY write decimal digits of prime plus newline to output stream
    ON failure:
      RETURN FAILURE_MODE WriteFailure
