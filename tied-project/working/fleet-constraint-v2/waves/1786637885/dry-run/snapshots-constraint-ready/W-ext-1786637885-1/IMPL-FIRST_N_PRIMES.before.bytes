# [IMPL-FIRST_N_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# Summary: Return the ascending first n primes for a valid count using incremental trial division by already found primes.


Grammar-Version: v2

## FIRST_N_PRIMES
# [IMPL-FIRST_N_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# How: return the ascending first n primes for valid count.

Contract:
  INPUT: count
  OUTPUT: first_n_primes_list
  DATA: found_list
  PRE: count is a non-negative host integer
  POST: list length equals count; values are prime numbers in increasing order; count 0 yields empty list
  EFFECTS: pure
  FAILURE_MODES: InvalidCount
  TERMINATION: total

procedure FIRST_N_PRIMES:
  CALL VALIDATE_COUNT(count)
  CALL COLLECT_PRIMES(count)
  RETURN found_list

## VALIDATE_COUNT
# [IMPL-FIRST_N_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# How: reject invalid count.

Contract:
  INPUT: count
  OUTPUT: proceed_or_InvalidCount
  PRE: count provided
  POST: proceed only when count is host integer >= 0
  EFFECTS: Exn on failure
  FAILURE_MODES: InvalidCount
  TERMINATION: total

procedure VALIDATE_COUNT:
  IF count is not a host integer OR count < 0:
    RETURN FAILURE_MODE InvalidCount
  PROCEED

## COLLECT_PRIMES
# [IMPL-FIRST_N_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# How: grow a list by testing increasing candidate values starting at 2 until length equals count.

Contract:
  INPUT: count
  OUTPUT: found_list
  DATA: found_list; candidate
  PRE: VALIDATE_COUNT succeeded; count is a non-negative host integer
  POST: found_list length equals count; values are prime numbers in increasing order
  EFFECTS: pure
  DATA_TRANSITION: found list empty→length count
  TERMINATION: total (finite count; candidate strictly increases)

procedure COLLECT_PRIMES:
  SET found_list = empty list
  SET candidate = 2
  WHILE length(found_list) < count:
    IF CANDIDATE_IS_PRIME(candidate, found_list):
      APPEND candidate to found_list
    SET candidate = candidate + 1
  RETURN found_list

## CANDIDATE_IS_PRIME
# [IMPL-FIRST_N_PRIMES] [ARCH-PRIME_FUNCTION_MODULES] [REQ-FIRST_FIVE_PRIMES]
# How: a candidate is prime iff no already found prime divides it (empty found list ⇒ 2 is prime).

Contract:
  INPUT: candidate; found_list
  OUTPUT: is_prime
  PRE: candidate is an integer >= 2; found_list contains only smaller prime numbers
  POST: is_prime is true iff no element of found_list divides candidate
  EFFECTS: pure
  TERMINATION: total

procedure CANDIDATE_IS_PRIME:
  IF found_list is empty:
    RETURN true
  FOR each p IN found_list:
    IF candidate modulo p equals 0:
      RETURN false
  RETURN true
