# [IMPL-ROOTJOBS_RENDER] [ARCH-ROOTJOBS_MODULES] [REQ-ROOTJOBS_OUTPUT]
# Summary: Render Forest as indented text tree or nested JSON with snake_case contract.


Grammar-Version: v2

## RENDER_TEXT
# [IMPL-ROOTJOBS_RENDER] [ARCH-ROOTJOBS_MODULES] [REQ-ROOTJOBS_OUTPUT]
# How: Header summary line plus box-drawing tree walk.

Contract:
  INPUT: Forest forest
  OUTPUT: string text to stdout
  PRE: forest sorted by SORT_FOREST
  POST: first line "rootjobs snapshot (N processes, M roots)"; each process one line
  EFFECTS: State — formatted text buffer
  TERMINATION: total — finite tree walk

procedure RENDER_TEXT(forest, w):
  WRITE header with process_count and root_count
  FOR each root IN forest.Roots:
    RENDER node line "[pid] name (PPID ppid) — state"
    WALK children with ├──/└── prefixes

## RENDER_JSON
# [IMPL-ROOTJOBS_RENDER] [ARCH-ROOTJOBS_MODULES] [REQ-ROOTJOBS_OUTPUT]
# How: Emit {summary, roots[]} with snake_case tags; optional pretty indent.

procedure RENDER_JSON(forest, w, pretty):
  Contract:
    INPUT: Forest; pretty bool
    OUTPUT: JSON bytes
    POST: summary.process_count, summary.root_count, roots[].process, roots[].children nested
    EFFECTS: State — JSON document
    FAILURE_MODES: MARSHAL_ERROR
  payload := { summary: {process_count, root_count}, roots: nested nodes }
  IF pretty: json.MarshalIndent else json.Marshal
  WRITE to w

## ON marshal_error
# [IMPL-ROOTJOBS_RENDER] [ARCH-ROOTJOBS_MODULES] [REQ-ROOTJOBS_OUTPUT]
# How: Return error to caller for exit code 1.

  RETURN error to CLI Run
