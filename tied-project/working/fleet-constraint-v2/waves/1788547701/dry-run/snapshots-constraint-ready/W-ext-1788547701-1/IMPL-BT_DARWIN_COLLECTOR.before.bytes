// [IMPL-BT_DARWIN_COLLECTOR] [ARCH-BT_BATTERY_CLI] [REQ-BT_BATTERY_DISPLAY]
// Collect and merge connected-device battery data from macOS system commands.


Grammar-Version: v2

procedure COLLECT_CONNECTED_BLUETOOTH_DEVICES:
  PRE: process.platform === 'darwin'
  POST: returns BluetoothDevice[] where every item has connected === true
  EFFECTS: spawns subprocesses system_profiler and pmset (read-only)
  FAILURE_MODES: profiler subprocess non-zero exit → throw CollectorError

  // [IMPL-BT_DARWIN_COLLECTOR] Parse connected rows only from profiler JSON
  profilerRows ← PARSE_SYSTEM_PROFILER_CONNECTED(
    exec('system_profiler SPBluetoothDataType -json')
  )

  // [IMPL-BT_DARWIN_COLLECTOR] pmset supplements missing batteries; non-fatal on failure
  TRY
    pmsetRows ← PARSE_PMSET_ACCESSORIES(exec('pmset -g accps'))
  CATCH PmsetError
    LOG stderr warning
    pmsetRows ← []

  RETURN MERGE_CONNECTED_DEVICES(profilerRows, pmsetRows)

procedure PARSE_SYSTEM_PROFILER_CONNECTED:
  INPUT: jsonText
  POST: BluetoothDevice[] from device_connected only

  DATA ← JSON.parse(jsonText)
  connected ← DATA.SPBluetoothDataType[0].device_connected OR []
  FOR EACH entry IN connected
    name ← first key of entry
    fields ← entry[name]
    battery ← NORMALIZE_PERCENT(fields.device_batteryLevelMain OR fields.device_battery_level_main)
    notes ← BUILD_EARBUD_NOTES(fields)
    EMIT { name, address: fields.device_address, connected: true,
           batteryPercent: battery, batterySource: battery ? 'system_profiler' : 'unknown', notes }

procedure PARSE_PMSET_ACCESSORIES:
  INPUT: text
  POST: BluetoothDevice[] with connected true and batterySource pmset when parsed

  FOR EACH line matching accessory pattern
    EMIT { name, connected: true, batteryPercent, batterySource: 'pmset' }

procedure MERGE_CONNECTED_DEVICES:
  INPUT: profilerRows, pmsetRows
  POST: sorted unique BluetoothDevice[] by normalized name

  map ← index profilerRows by NORMALIZE_NAME(name)
  FOR EACH pmsetRow IN pmsetRows
    IF map has match AND match.batteryPercent defined THEN continue
    IF map has match AND match.batteryPercent missing THEN fill battery from pmset; set batterySource pmset
    ELSE append pmsetRow
  RETURN sort values(map) alphabetically by name

procedure NORMALIZE_PERCENT:
  INPUT: value like "85%" or number
  POST: integer 0-100 or undefined

procedure NORMALIZE_NAME:
  INPUT: name string
  POST: trim, collapse whitespace, lowercase for matching
