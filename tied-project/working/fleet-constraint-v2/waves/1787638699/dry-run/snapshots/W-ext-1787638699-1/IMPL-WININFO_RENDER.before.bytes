# IMPL-WININFO_RENDER essence pseudocode

// [IMPL-WININFO_RENDER] [ARCH-WININFO_CLI_OUTPUT] [REQ-WININFO_OPEN_WINDOWS]
// Render window list as fixed-column table to stdout.
PROCEDURE FORMAT_TABLE
  PRE: windows slice (may be empty)
  INPUT: windows []Window, writer io.Writer
  POST: header row ID APP TITLE X Y W H VIS then one row per window
  EFFECTS: empty title displayed as "(no title)"; VIS is yes/no
  FAILURE_MODES: writer error -> propagate

// [IMPL-WININFO_RENDER] [ARCH-WININFO_CLI_OUTPUT] [REQ-WININFO_OPEN_WINDOWS]
PROCEDURE FORMAT_JSON
  PRE: windows slice (may be empty)
  INPUT: windows []Window, writer io.Writer
  POST: valid JSON array of Window objects; empty input -> "[]\n"
  EFFECTS: title field uses empty string when unavailable
  FAILURE_MODES: marshal error -> return error

// [IMPL-WININFO_RENDER] [ARCH-WININFO_CLI_OUTPUT] [REQ-WININFO_OPEN_WINDOWS]
PROCEDURE EMIT_TITLE_HINT
  PRE: windows emitted to stdout
  INPUT: windows []Window, stderr io.Writer
  CONTROL: IF count(empty title) / count(windows) > 0.5 AND count(windows) > 0
  EFFECTS: print one-line Accessibility hint to stderr (once)
  POST: hint not printed when most titles present
