# IMPL-WININFO_CLI essence pseudocode

// [IMPL-WININFO_CLI] [ARCH-WININFO_CLI_OUTPUT] [REQ-WININFO_OPEN_WINDOWS]
PROCEDURE PARSE_FLAGS
  PRE: os.Args available
  INPUT: args []string
  OUTPUT: json bool, all_layers bool, include_offscreen bool
  POST: unknown flags -> exit code 2
  FAILURE_MODES: flag parse error -> exit 2

// [IMPL-WININFO_CLI] [IMPL-WININFO_FILTER] [IMPL-WININFO_RENDER] [REQ-WININFO_OPEN_WINDOWS]
PROCEDURE RUN_CLI
  PRE: Lister injected (darwin or mock)
  INPUT: flags, lister Lister, stdout, stderr
  DATA: raw = lister.List(opts with include_offscreen)
  DATA: filtered = APPLY_LAYER_FILTER(raw, all_layers)
  DATA: sorted = SORT_WINDOWS(filtered)
  CONTROL: IF json THEN FORMAT_JSON ELSE FORMAT_TABLE
  EFFECTS: EMIT_TITLE_HINT(sorted, stderr)
  POST: exit 0 on success
  FAILURE_MODES: list error -> exit 1; render error -> exit 1
