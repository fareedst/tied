# [IMPL-LISTENING_PORT_COLLECT] [ARCH-LISTENING_PORT_CLI] [REQ-LISTENING_PORT_REPORT]
# How: Enumerates OS connection tables and returns normalized listening sockets.

TYPE Listener
  DATA protocol string  # "tcp" | "udp"
  DATA address string   # normalized bind IP
  DATA port int         # 1-65535

TYPE ProtocolFilter
  DATA value in {all, tcp, udp}

PROC COLLECT_LISTENING
  INPUT: protocol_filter ProtocolFilter
  OUTPUT: []Listener or error
  PRE: protocol_filter parsed and valid
  POST: only listening-equivalent sockets; deduped; stably sorted by protocol, address, port
  EFFECTS: reads OS network tables via gopsutil Connections
  FAILURE_MODES: Connections error → return error (fail closed; no partial results)

  # How: Map CLI filter to gopsutil kind list.
  kinds := SELECT_PROTOCOL_KINDS(protocol_filter)

  listeners := empty []Listener

  FOR each kind in kinds:
    # How: Fail closed on any protocol collection error.
    connections, err := gopsutil.Connections(kind)
    IF err != nil THEN RETURN nil, err

    FOR each row in connections:
      # How: TCP rows must be LISTEN state only.
      IF kind == tcp AND row.Status != LISTEN THEN CONTINUE

      # How: UDP uses bound listening equivalent heuristic (no TCP-style LISTEN).
      IF kind == udp AND NOT isBoundListeningEquivalent(row) THEN CONTINUE

      # How: Normalize bind address (strip zone, map ::ffff:x.x.x.x → IPv4).
      addr := normalizeAddress(row.Laddr.IP)
      port := row.Laddr.Port

      IF port < 1 OR port > 65535 THEN CONTINUE

      APPEND Listener{protocol: kind, address: addr, port: port} TO listeners

  # How: Remove duplicate protocol+address+port tuples.
  listeners := DEDUPE(listeners)

  # How: Stable sort for deterministic JSON output.
  SORT(listeners, protocol, address, port)

  RETURN listeners, nil

PROC SELECT_PROTOCOL_KINDS
  INPUT: protocol_filter ProtocolFilter
  OUTPUT: []string
  PRE: protocol_filter.value in {all, tcp, udp}
  POST: returns non-empty kind list for valid filter

  IF protocol_filter.value == all THEN RETURN [tcp, udp]
  IF protocol_filter.value == tcp THEN RETURN [tcp]
  RETURN [udp]

PROC normalizeAddress
  INPUT: ip string
  OUTPUT: string
  PRE: ip non-empty
  POST: zone ID stripped; gopsutil * wildcard mapped to 0.0.0.0; IPv4-mapped IPv6 returned as dotted-quad; 0.0.0.0 and :: preserved

  IF ip == "*" THEN RETURN 0.0.0.0
  Strip IPv6 zone suffix after '%'
  IF ip matches ::ffff:x.x.x.x THEN RETURN IPv4 dotted-quad form
  RETURN ip

PROC isBoundListeningEquivalent
  INPUT: row ConnectionStat
  OUTPUT: bool
  PRE: row from UDP Connections query
  POST: true when row represents a bound UDP socket awaiting datagrams

  RETURN row has valid Laddr IP and port in 1-65535

PROC DEDUPE
  INPUT: []Listener
  OUTPUT: []Listener
  POST: no duplicate (protocol, address, port) tuples

  USE map key protocol+address+port; preserve first occurrence order before final sort
