# [IMPL-LISTENING_PORT_COLLECT] [IMPL-LISTENING_PORT_JSON] [ARCH-LISTENING_PORT_CLI] [REQ-LISTENING_PORT_REPORT]
# How: Parses flags, invokes collector, encodes JSON, sets exit code.

PROC MAIN
  INPUT: argv, env, stdin, stdout, stderr
  OUTPUT: process exit code
  PRE: argv available
  POST: stdout valid JSON on success OR stderr error message; exit code 0 or 1
  TERMINATION: single pass; no retry loop

  # How: Default --protocol all; validate flag value.
  protocol_filter := PARSE_FLAGS(argv)  # --protocol all|tcp|udp

  IF protocol_filter invalid THEN
    WRITE stderr usage message
    EXIT 1

  # How: Wire default gopsutil collector (injectable in tests).
  collector := NewGopsutilCollector()
  listeners, err := collector.CollectListening(protocol_filter)

  IF err != nil THEN
    WRITE stderr error message
    EXIT 1

  err := ENCODE_REPORT(listeners, stdout)
  IF err != nil THEN
    WRITE stderr error message
    EXIT 1

  EXIT 0
