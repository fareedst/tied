# [IMPL-ARCHIVEINFO-CLI-CMD] CLI orchestration
# Implements [ARCH-ARCHIVEINFO-CLI], [ARCH-ARCHIVEINFO-MODULES] for [REQ-ARCHIVEINFO-DISPLAY]

PROCEDURE Run(args []string, cwd string, stdout io.Writer, stderr io.Writer) -> int
  // [IMPL-ARCHIVEINFO-CLI-CMD] [ARCH-ARCHIVEINFO-MODULES] [REQ-ARCHIVEINFO-DISPLAY] — orchestrate parse→glob→read→render
  INPUT: args, cwd, stdout, stderr
  PRE: args is os.Args-style slice
  POST: stdout has metadata for successful archives; stderr lists failures
  EFFECTS:
    cfg, err := config.Parse(args)
    IF err != nil THEN
      write err to stderr
      RETURN 2
    IF cfg.ShowHelp THEN
      write usage to stdout
      RETURN 0
    paths := glob.Expand(cwd, cfg.GlobPattern)
    IF len(paths) == 0 THEN
      write "no files matched pattern" to stderr
      RETURN 1
    successes := []
    hadError := false
    FOR each path IN paths:
      fmt := format.Detect(path)
      IF fmt == FormatUnknown THEN
        write failure to stderr
        hadError = true
        CONTINUE
      info, err := reader.Read(path, fmt)
      IF err != nil THEN
        write failure to stderr
        hadError = true
        CONTINUE
      append info to successes
    display.Render(successes, cfg.JSON, stdout)
    IF hadError THEN RETURN 1
    RETURN 0
  FAILURE_MODES: usage → 2; zero matches → 1; read error → 1
  TERMINATION: always returns 0, 1, or 2
