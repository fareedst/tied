// [IMPL-LAUNCHD_COLLECTOR] [ARCH-MACOS_SERVICE_REPORT] [REQ-MACOS_SERVICE_REPORT]
// Collect and parse launchd GUI-domain services from launchctl list.

PROC COLLECT_LAUNCHD_SERVICES(runner)
  PRE: runner conforms to ProcessRunner protocol
  POST: returns sorted [LaunchdService] OR ParseError
  EFFECTS: invokes /bin/launchctl list via runner
  DATA_TRANSITION: raw stdout -> validated rows -> LaunchdService models
  FAILURE_MODES: subprocess failure -> SubprocessError; unparseable row -> ParseError

PROC PARSE_LAUNCHD_ROW(line)
  PRE: line is non-header row from launchctl list
  POST: returns LaunchdService OR nil if blank
  EFFECTS: none
  // PID "-" -> stopped; PID > 0 -> running; negative status -> stopped(exitCode)

PROC SORT_LAUNCHD_SERVICES(services)
  PRE: services is array
  POST: returns array sorted by label ascending
  EFFECTS: none
