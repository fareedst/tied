// [IMPL-SERVICE_REPORT_CLI] [ARCH-MACOS_SERVICE_REPORT] [REQ-MACOS_SERVICE_REPORT]
// CLI entry: parse flags, run collectors, format and print report.

PROC MAIN(argv, runner)
  PRE: argv parseable by ArgumentParser
  POST: writes formatted report to stdout OR error message to stderr
  EFFECTS: runs zero, one, or two collectors based on flags; fail-fast on first collector error
  TERMINATION: exit 0 on success; 1 on collector failure; 2 on usage error

PROC BUILD_REPORT(flags, runner)
  PRE: flags valid; at least one section selected
  POST: returns ServiceReport with default partial-visibility warning
  EFFECTS: invokes COLLECT_LAUNCHD_SERVICES and/or COLLECT_NETWORK_LISTENERS
  FAILURE_MODES: any collector error aborts without partial report

PROC RUN_CLI()
  PRE: macOS platform
  POST: process terminates with exit code per MAIN
  EFFECTS: writes stdout/stderr
