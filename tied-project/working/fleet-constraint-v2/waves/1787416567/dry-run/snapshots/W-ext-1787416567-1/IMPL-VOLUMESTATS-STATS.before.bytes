# [IMPL-VOLUMESTATS-STATS] [ARCH-VOLUMESTATS-MODULES] [REQ-VOLUMESTATS-DARWIN-MOUNTS] [REQ-VOLUMESTATS-CLI]
# How: Convert filesystem counters and collect independent mount statistics with partial-failure tolerance.
Contract:
  INPUT: mount_points (list of paths), diagnostics (writer)
  PRE: mount_points contains absolute paths; diagnostics accepts text output
  OUTPUT: volume_stats (list of VolumeStats) | error
  POST: each output row corresponds to one successful Statfs call; error occurs only when zero rows succeed
  FAILURE_MODES: STATFS_FAILED; NO_VOLUMES_SUCCEEDED
  EFFECTS: IO
  TERMINATION: total

# [IMPL-VOLUMESTATS-STATS] [ARCH-VOLUMESTATS-MODULES] [REQ-VOLUMESTATS-DARWIN-MOUNTS] [REQ-VOLUMESTATS-CLI]
# How: Convert block counters into raw bytes and a bounded usage percentage.
procedure STATFS_TO_VOLUME_STATS:
  total_bytes := blocks multiplied by block_size
  available_bytes := nonnegative available_blocks multiplied by block_size
  IF available_bytes is greater than total_bytes: used_bytes := 0 ELSE used_bytes := total_bytes minus available_bytes
  denominator := used_bytes plus available_bytes
  IF denominator is zero: used_percent := 0 ELSE used_percent := used_bytes divided by denominator times 100
  RETURN VolumeStats(name, mount_point, filesystem, total_bytes, used_bytes, available_bytes, used_percent)

# [IMPL-VOLUMESTATS-STATS] [ARCH-VOLUMESTATS-MODULES] [REQ-VOLUMESTATS-DARWIN-MOUNTS] [REQ-VOLUMESTATS-CLI]
# How: Iterate mounts independently so one failing Statfs does not discard successful rows.
procedure COLLECT_VOLUME_STATS:
  # [IMPL-VOLUMESTATS-STATS] [ARCH-VOLUMESTATS-MODULES] [REQ-VOLUMESTATS-DARWIN-MOUNTS] [REQ-VOLUMESTATS-CLI]
  results := empty list
  FOR mount_point IN mount_points:
    statfs_result := STATFS(mount_point)
    IF statfs_result fails: WRITE diagnostics `DEBUG: skipping volume`; CONTINUE
    ADD STATFS_TO_VOLUME_STATS(statfs_result) to results
  IF results is empty: RETURN results, NO_VOLUMES_SUCCEEDED
  RETURN results, nil