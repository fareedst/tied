# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# Summary: Split prime predicate, first-n generator, and print wrapper so the first five primes can be unit-tested then printed to stdout.

## IS_PRIME
# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Return true iff candidate is a prime number.

# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Contract for the prime predicate — pure boolean over one integer candidate.
Contract:
  INPUT: candidate
  OUTPUT: is_prime_boolean
  DATA: trial_divisor
  CONTROL: none
  PRE: candidate is an integer
  POST: is_prime_boolean is true iff candidate is greater than 1 and has no integer divisor in 2 .. floor(sqrt(candidate))
  EFFECTS: pure
  FAILURE_MODES: INVALID_CANDIDATE
  TERMINATION: total — trial loop is bounded by floor(sqrt(candidate))

# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Return true iff candidate is a prime number.
procedure IS_PRIME(candidate):
  # [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
  # How: Reject non-integer candidates, treat values below 2 as not prime, then trial-divide up to sqrt.
  Contract:
    INPUT: candidate
    OUTPUT: is_prime_boolean
    PRE: candidate is an integer
    POST: true iff candidate is a prime number
    EFFECTS: pure
    FAILURE_MODES: INVALID_CANDIDATE
    TERMINATION: total — trial loop is bounded by floor(sqrt(candidate))
  IF candidate is not an integer:
    RETURN FAILURE_MODE INVALID_CANDIDATE
  IF candidate < 2:
    RETURN false
  FOR trial_divisor IN 2 .. floor(sqrt(candidate)):
    IF candidate modulo trial_divisor equals 0:
      RETURN false
  RETURN true

## FIRST_N_PRIMES
# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Collect the first n primes in ascending order by scanning candidates and calling IS_PRIME.

# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Contract for the first-n generator — pure ordered list of the smallest n prime numbers.
Contract:
  INPUT: count
  OUTPUT: primes_list
  DATA: primes_list; candidate
  CONTROL: stop when length(primes_list) equals count
  PRE: count is an integer greater than or equal to 0
  POST: length(primes_list) equals count; primes_list is strictly ascending; every element satisfies IS_PRIME; when count is 5, primes_list is 2, 3, 5, 7, 11
  EFFECTS: pure
  FAILURE_MODES: INVALID_COUNT
  DATA_TRANSITION: primes_list empty → length count; candidate starts at 2 and advances by 1 after each IS_PRIME test
  TERMINATION: total — WHILE stops when length(primes_list) equals finite count

# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Collect the first n primes in ascending order by scanning candidates and calling IS_PRIME.
procedure FIRST_N_PRIMES(count):
  # [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
  # How: Validate count, then append each successive prime number until the list length equals count.
  Contract:
    INPUT: count
    OUTPUT: primes_list
    PRE: count is an integer greater than or equal to 0
    POST: length(primes_list) equals count; when count is 5 the list is 2, 3, 5, 7, 11
    EFFECTS: pure
    FAILURE_MODES: INVALID_COUNT
    DATA_TRANSITION: primes_list empty → length count
    TERMINATION: total — WHILE stops when length(primes_list) equals finite count
  IF count is not an integer OR count < 0:
    RETURN FAILURE_MODE INVALID_COUNT
  SET primes_list = empty list
  SET candidate = 2
  WHILE length(primes_list) < count:
    IF IS_PRIME(candidate) is true:
      APPEND candidate onto primes_list
    SET candidate = candidate + 1
  RETURN primes_list

## PRINT_FIRST_FIVE_PRIMES
# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Print the first five primes to stdout by composing FIRST_N_PRIMES(5) with one line per prime number.

# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Contract for the print wrapper — IO effect, count fixed at 5, injectable destination for composition tests.
Contract:
  INPUT: output_stream (default stdout)
  OUTPUT: none
  DATA: primes_list
  CONTROL: count_fixed_at_5
  PRE: output_stream accepts line writes; FIRST_N_PRIMES is independently validated
  POST: output_stream contains five lines 2, 3, 5, 7, 11 in that order, each terminated by a newline
  EFFECTS: IO
  FAILURE_MODES: GENERATOR_FAILED; IO_WRITE_FAILED
  DATA_TRANSITION: none — no durable State; primes_list is local
  TERMINATION: total — FOR iterates the five-element list once

# [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
# How: Print the first five primes to stdout by composing FIRST_N_PRIMES(5) with one line per prime number.
procedure PRINT_FIRST_FIVE_PRIMES(output_stream):
  # [IMPL-FIRST_FIVE_PRIMES] [ARCH-FIRST_FIVE_PRIMES] [REQ-FIRST_FIVE_PRIMES]
  # How: Call FIRST_N_PRIMES(5) then write each prime number as one stdout line.
  Contract:
    INPUT: output_stream (default stdout)
    OUTPUT: none
    PRE: output_stream accepts line writes
    POST: five lines 2, 3, 5, 7, 11 written in order
    EFFECTS: IO
    FAILURE_MODES: GENERATOR_FAILED; IO_WRITE_FAILED
    TERMINATION: total — FOR iterates the five-element list once
  SET primes_list = FIRST_N_PRIMES(5)
  ON error from FIRST_N_PRIMES:
    RETURN FAILURE_MODE GENERATOR_FAILED
  FOR each prime_number IN primes_list:
    WRITE prime_number as one line to output_stream
    ON error:
      RETURN FAILURE_MODE IO_WRITE_FAILED
  RETURN
