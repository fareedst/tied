# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# Summary: Map OS interfaces via injectable InterfaceLister to sorted []InterfaceReport; fatal only on List failure; partial Addrs failure yields empty addresses.

## DISCOVER_INTERFACES
# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Contract-precise discovery — enumerate via lister, map each interface to InterfaceReport, sort by index ascending.

# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: lister implementing InterfaceLister with List() ([]InterfaceSource, error)
  OUTPUT: sorted []InterfaceReport OR discover_error
  DATA: InterfaceReport{name, index, up, loopback, hardware_addr, addresses}
  CONTROL: continue_on_addrs_error; fatal_on_list_error
  PRE: lister is non-nil and implements InterfaceLister
  POST: len(reports) == len(interfaces) on success; reports sorted by index ASC
  EFFECTS: State — reports slice populated; no OS mutation
  FAILURE_MODES: LIST_FAILED — returns error when lister.List() fails
  DATA_TRANSITION: interfaces empty→mapped; reports empty→sorted slice
  TERMINATION: total — finite loop over interfaces

# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Execute discovery lifecycle — List, map each interface, sort, return.
procedure DISCOVER_INTERFACES(lister):
  # [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
  # How: Obtain raw interfaces; List failure is fatal.
  interfaces, err = lister.List()
  IF err IS NOT nil:
    RETURN discover_error(err)
  reports = empty slice of InterfaceReport
  FOR each iface IN interfaces:
    # [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
    # How: Map Addrs; on Addrs error use empty addresses and continue.
    addrs, addrErr = iface.Addrs()
    IF addrErr IS nil:
      addresses = MAP_TO_STRINGS(addrs)
    ELSE:
      addresses = empty slice
    up = iface.Flags() contains FlagUp
    loopback = iface.Flags() contains FlagLoopback
    hardware_addr = iface.HardwareAddr().String() OR empty string when unavailable
    APPEND InterfaceReport{
      name: iface.Name(),
      index: iface.Index(),
      up: up,
      loopback: loopback,
      hardware_addr: hardware_addr,
      addresses: addresses
    } TO reports
  SORT reports BY index ASC
  RETURN reports

## MAP_TO_STRINGS
# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Convert net.Addr slice to display strings — CIDR for *net.IPNet, plain IP otherwise.

# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: []net.Addr
  OUTPUT: []string address display strings
  PRE: addrs may be empty
  POST: each element is IP or CIDR string; order preserved from input
  EFFECTS: none — pure mapping
  TERMINATION: total

# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Iterate addrs and format each by type.
procedure MAP_TO_STRINGS(addrs):
  result = empty slice
  FOR each addr IN addrs:
    IF addr IS *net.IPNet:
      APPEND addr.String() TO result
    ELSE IF addr IS *net.IPAddr:
      APPEND addr.IP.String() TO result
    ELSE:
      APPEND addr.String() TO result
  RETURN result

## INTERFACE_SOURCE
# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Narrow seam for test doubles — Name, Index, Flags, HardwareAddr, Addrs.

# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: none (interface type)
  OUTPUT: methods Name() string, Index() int, Flags() net.Flags, HardwareAddr() net.HardwareAddr, Addrs() ([]net.Addr, error)
  PRE: none
  POST: each method delegates to one OS interface record
  EFFECTS: none — type contract only
  TERMINATION: total

## OS_LISTER
# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Default production lister — net.Interfaces() wrapped as []InterfaceSource.

# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: none
  OUTPUT: []InterfaceSource, error from net.Interfaces()
  PRE: process has permission to enumerate interfaces
  POST: returns OS-visible interface list adapted via osInterface wrapper
  EFFECTS: read-only OS query
  FAILURE_MODES: LIST_FAILED when net.Interfaces() returns error
  TERMINATION: total

# [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Wrap each net.Interface in osInterface for InterfaceSource compliance.
procedure OS_LISTER.List(): # [IMPL-NETIF_DISCOVERY] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
  ifaces, err = net.Interfaces()
  IF err IS NOT nil:
    RETURN nil, err
  sources = empty slice of InterfaceSource
  FOR each iface IN ifaces:
    APPEND osInterface{iface: iface} TO sources
  RETURN sources
