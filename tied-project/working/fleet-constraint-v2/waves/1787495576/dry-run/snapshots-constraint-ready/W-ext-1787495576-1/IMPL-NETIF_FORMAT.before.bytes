# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# Summary: Pure formatters render sorted []InterfaceReport as human text or JSON bytes; empty input yields empty output.


Grammar-Version: v2

## FORMAT_HUMAN
# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Multi-line human-readable layout with ifconfig-style fields; hardware (none) when empty.

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: reports []InterfaceReport sorted by index ASC
  OUTPUT: multi-line UTF-8 string
  PRE: reports already sorted (caller responsibility)
  POST: empty slice → empty string; each interface block includes name, index, flags, hardware, addresses
  EFFECTS: none — pure function
  TERMINATION: total

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Build text blocks separated by blank lines.
procedure FORMAT_HUMAN(reports):
  IF len(reports) == 0:
    RETURN empty string
  lines = empty slice
  FOR each report IN reports:
    APPEND "Interface: {name} (index {index})" TO lines
    flags = BUILD_FLAG_LIST(report.up, report.loopback)
    APPEND "  Flags: {flags}" TO lines
    hw = report.hardware_addr IF non-empty ELSE "(none)"
    APPEND "  Hardware: {hw}" TO lines
    APPEND "  Addresses:" TO lines
    FOR each addr IN report.addresses:
      APPEND "    - {addr}" TO lines
    IF report is not last:
      APPEND blank line TO lines
  RETURN join(lines, newline)

## FORMAT_JSON
# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Emit JSON array of objects with keys name, index, up, loopback, hardware_addr, addresses.

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: reports []InterfaceReport sorted by index ASC
  OUTPUT: valid JSON byte slice
  PRE: reports already sorted
  POST: empty slice → "[]" or empty array JSON; each object has required keys
  EFFECTS: none — pure function
  FAILURE_MODES: JSON_ENCODE_FAILED on marshal error
  TERMINATION: total

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Marshal structured records to JSON.
procedure FORMAT_JSON(reports):
  IF len(reports) == 0:
    RETURN "[]" bytes
  records = MAP each report TO jsonObject{name, index, up, loopback, hardware_addr, addresses}
  bytes, err = json.Marshal(records)
  IF err IS NOT nil:
    RETURN json_encode_error(err)
  RETURN bytes

## VERIFY_JSON_HUMAN_EQUIVALENCE
# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Confirm JSON and human renderings preserve the same logical report fields for the same input.

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: reports []InterfaceReport
  OUTPUT: equivalence assertion result
  PRE: reports are the same ordered input supplied to FORMAT_JSON and FORMAT_HUMAN
  POST: every report name, index, flags, hardware address, and address value appears consistently in both renderings
  EFFECTS: none — test-only oracle
  FAILURE_MODES: REPRESENTATION_MISMATCH — identify the first field that differs
  TERMINATION: total

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Parse JSON output and compare each logical field with the corresponding human output assertions.
procedure VERIFY_JSON_HUMAN_EQUIVALENCE(reports):
  jsonRecords = PARSE_JSON(FORMAT_JSON(reports))
  humanText = FORMAT_HUMAN(reports)
  ASSERT len(jsonRecords) == len(reports)
  FOR each report at index i:
    ASSERT jsonRecords[i] fields match report
    ASSERT humanText contains report name, index, flags, hardware address, and each address
  RETURN equivalent

## BUILD_FLAG_LIST
# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Compose comma-separated flag labels for human output.

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
Contract:
  INPUT: up bool, loopback bool
  OUTPUT: comma-separated flag string (e.g. "up, loopback" or "down")
  PRE: none
  POST: always includes up/down; includes loopback when true
  EFFECTS: none
  TERMINATION: total

# [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
# How: Collect active flag labels.
procedure BUILD_FLAG_LIST(up, loopback): # [IMPL-NETIF_FORMAT] [ARCH-NETIF_REPORT] [REQ-NETIF_REPORT]
  flags = empty slice
  IF up: APPEND "up" ELSE APPEND "down"
  IF loopback: APPEND "loopback"
  RETURN join(flags, ", ")
